@{
    ViewData["Title"] = "Добавление автомобиля";
}

<h2>Информация об автомобиле</h2>

<form asp-action="Index" method="post">
    <div class="form-group">
        <label>ID автомобиля (число)</label>
        <input type="text" name="carId" class="form-control" />
    </div>

    <div class="form-group">
        <label>Марка</label>
        <input type="text" name="brand" class="form-control" />
    </div>

    <div class="form-group">
        <label>Модель</label>
        <input type="text" name="model" class="form-control" />
    </div>

    <div class="form-group">
        <label>Год выпуска</label>
        <input type="number" name="year" class="form-control" />
    </div>

    <div class="form-group">
        <label>В наличии</label>
        <input type="checkbox" name="isAvailable" value="true" checked />
        <input type="hidden" name="isAvailable" value="false" />
    </div>

    <div class="form-group">
        <label>Тип топлива</label>
        <select name="fuelType" class="form-control">
            <option value="">-- Выберите тип --</option>
            <option value="Бензин">Бензин</option>
            <option value="Дизель">Дизель</option>
            <option value="Электро">Электро</option>
            <option value="Гибрид">Гибрид</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>