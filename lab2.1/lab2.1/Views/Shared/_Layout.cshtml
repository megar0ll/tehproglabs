<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
            body {
                background-color: #1a1a2e;
                font-family: 'Consolas', 'Courier New', monospace;
                color: #e0e0e0;
            }
            .navbar {
                background-color: #0f0f1a !important;
                border-bottom: 2px solid #2d2d44;
            }
            .navbar-brand {
                color: #4ade80 !important;
                font-family: monospace;
                font-size: 16px;
            }
            .navbar-nav .nav-link {
                color: #a0a0b0 !important;
            }
            .navbar-nav .nav-link:hover {
                color: #4ade80 !important;
            }
            footer {
                background-color: #0f0f1a;
                border-top: 1px solid #2d2d44;
                text-align: center;
                padding: 12px;
                font-size: 10px;
                color: #5a5a7a;
                position: fixed;
                bottom: 0;
                width: 100%;
            }
            .btn {
                border-radius: 0;
                font-family: monospace;
                font-size: 11px;
                padding: 5px 12px;
                border: 1px solid;
            }
            .btn-success {
                background-color: transparent;
                border-color: #4ade80;
                color: #4ade80;
            }
            .btn-success:hover {
                background-color: #4ade80;
                color: #0f0f1a;
            }
            .btn-info {
                background-color: transparent;
                border-color: #3b82f6;
                color: #3b82f6;
            }
            .btn-info:hover {
                background-color: #3b82f6;
                color: #0f0f1a;
            }
            .btn-warning {
                background-color: transparent;
                border-color: #f59e0b;
                color: #f59e0b;
            }
            .btn-warning:hover {
                background-color: #f59e0b;
                color: #0f0f1a;
            }
            .btn-secondary {
                background-color: transparent;
                border-color: #6c757d;
                color: #a0a0b0;
            }
            .btn-primary {
                background-color: transparent;
                border-color: #3b82f6;
                color: #3b82f6;
            }
            .table {
                background-color: #0f0f1a;
                border: 1px solid #2d2d44;
                font-family: monospace;
                font-size: 13px;
            }
            .table thead th {
                background-color: #0a0a12;
                color: #4ade80;
            }
            .table tbody td {
                color: #c0c0d0;
            }
            .form-control {
                background-color: #0a0a12;
                border: 1px solid #2d2d44;
                color: #e0e0e0;
                font-family: monospace;
            }
            .form-control:focus {
                background-color: #0a0a12;
                border-color: #4ade80;
                box-shadow: none;
            }
            label {
                color: #4ade80;
                font-family: monospace;
                font-size: 12px;
            }
            .field-validation-error {
                color: #ef4444;
                font-size: 11px;
            }
            .validation-summary-errors {
                color: #ef4444;
                border-left: 3px solid #ef4444;
                padding: 8px;
                background-color: rgba(239,68,68,0.1);
                margin-bottom: 15px;
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-sm">
        <div class="container">
            <a class="navbar-brand" asp-controller="Car" asp-action="Index">[ CAR_MANAGER v2.1 ]</a>
            <div class="navbar-collapse collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Car" asp-action="Index">[ INVENTORY ]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Car" asp-action="Create">[ ADD CAR ]</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container" style="margin-top: 20px; margin-bottom: 60px;">
        <main>@RenderBody()</main>
    </div>

    <footer>[ CAR INVENTORY SYSTEM ] | ASP.NET CORE MVC</footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>