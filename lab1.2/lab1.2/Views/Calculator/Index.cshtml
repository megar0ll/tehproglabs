@model lab1._2.Models.CalculatorModel

@{
    ViewData["Title"] = "Калькулятор";
}

@* Секция для дополнительных стилей (пункт 3) *@
@section Styles {
    <style>
        .btn-calculate {
            background-color: #007bff;
            color: white;
        }
        .btn-clear {
            background-color: #6c757d;
            color: white;
        }
        .btn-clear:hover {
            background-color: #5a6268;
        }
        .radio-group {
            display: flex;
            gap: 20px;
            margin-top: 10px;
        }
        .radio-group label {
            cursor: pointer;
        }
        .result-value {
            font-size: 24px;
            font-weight: bold;
            color: #007bff;
        }
    </style>
}

<h2 class="text-center mb-4">Калькулятор (lab1.2)</h2>

@using (Html.BeginForm("Calculate", "Calculator", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="form-group mb-3">
        @Html.LabelFor(model => model.Operand1, new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(model => model.Operand1, new { 
            @class = "form-control", 
            type = "number", 
            step = "1",
            placeholder = "Введите число от -128 до 127"
        })
        @Html.ValidationMessageFor(model => model.Operand1, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(model => model.Operand2, new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(model => model.Operand2, new { 
            @class = "form-control", 
            type = "number", 
            step = "any",
            placeholder = "Введите любое число"
        })
        @Html.ValidationMessageFor(model => model.Operand2, "", new { @class = "text-danger" })
    </div>

    <div class="form-group mb-3">
        <label class="form-label fw-bold">Выберите операцию:</label>
        <div class="radio-group">
            <label>
                @Html.RadioButtonFor(model => model.Operation, "+", new { @class = "me-1" })
                Сложение (+)
            </label>
            <label>
                @Html.RadioButtonFor(model => model.Operation, "-", new { @class = "me-1" })
                Вычитание (-)
            </label>
            <label>
                @Html.RadioButtonFor(model => model.Operation, "*", new { @class = "me-1" })
                Умножение (*)
            </label>
            <label>
                @Html.RadioButtonFor(model => model.Operation, "/", new { @class = "me-1" })
                Деление (/)
            </label>
        </div>
        @Html.ValidationMessageFor(model => model.Operation, "", new { @class = "text-danger" })
    </div>

    <div class="d-flex gap-2 mb-3">
        @* Две кнопки с одинаковым именем (атрибут name) - пункт 4 *@
        <button type="submit" name="submitButton" value="calculate" class="btn btn-calculate flex-grow-1">
            Вычислить
        </button>
        <button type="submit" name="submitButton" value="clear" class="btn btn-clear flex-grow-1">
            Очистить
        </button>
    </div>

    <div class="result-area">
        <h4 class="mb-2">Результат вычисления:</h4>
        <div class="result-value">@Model.Result</div>
    </div>
}

@* Пункт 2: Проверка равенства результата значению из ViewBag с использованием if-else *@
@{
    double targetValue = ViewBag.TargetValue != null ? (double)ViewBag.TargetValue : 0;
    string message = ViewBag.Message as string;
}

@if (Model.Result != 0 || ViewBag.Message != null)
{
    <div class="info-message @(Model.Result == targetValue ? "info-success" : "info-warning")">
        @if (!string.IsNullOrEmpty(message))
        {
            <p class="mb-0">@message</p>
        }
        else if (Model.Result == targetValue)
        {
            <p class="mb-0">
                <strong>✓ Совпадение!</strong> Результат вычисления (@Model.Result) 
                равен целевому значению (@targetValue).
            </p>
        }
        else
        {
            <p class="mb-0">
                <strong>⚠ Несовпадение!</strong> Результат вычисления (@Model.Result) 
                не равен целевому значению (@targetValue).
            </p>
        }
    </div>
}

@* Секция для дополнительных скриптов (пункт 3) *@
@section Scripts {
    <script>
        // Дополнительная валидация для sbyte
        $(document).ready(function() {
            $('form').on('submit', function() {
                var operand1 = $('#Operand1').val();
                if (operand1 !== '') {
                    var num = parseInt(operand1);
                    if (num < -128 || num > 127) {
                        alert('Первый операнд должен быть в диапазоне от -128 до 127 (тип sbyte)');
                        return false;
                    }
                }
                return true;
            });
        });
    </script>
}

@* Вывод отладочной информации (необязательно) *@
@if (ViewBag.TargetValue != null)
{
    <div class="mt-3 text-muted small text-center">
        Целевое значение для сравнения: <strong>@ViewBag.TargetValue</strong>
    </div>
}