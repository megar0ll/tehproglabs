@model lab2_3.Models.Car
@{
    ViewData["Title"] = "Редактирование";
}

<h2>Редактирование автомобиля</h2>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedDate" />
    
    <div class="form-group">
        <label asp-for="Brand">Марка</label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Model">Модель</label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Year">Год выпуска</label>
        <input asp-for="Year" class="form-control" type="number" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Price">Цена</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Mileage">Пробег (км)</label>
        <input asp-for="Mileage" class="form-control" type="number" />
        <span asp-validation-for="Mileage" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="FuelType">Тип топлива</label>
        <select asp-for="FuelType" class="form-control">
            <option value="">Выберите тип топлива</option>
            <option>Бензин</option>
            <option>Дизель</option>
            <option>Электричество</option>
            <option>Гибрид</option>
            <option>Газ</option>
        </select>
        <span asp-validation-for="FuelType" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label asp-for="Description">Описание</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label>
            <input asp-for="IsAvailable" type="checkbox" />
            В наличии
        </label>
    </div>
    
    <div class="form-group">
        <label>Дата добавления</label>
        <input value="@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")" class="form-control" readonly />
    </div>
    
    <button type="submit" class="btn btn-primary">Сохранить изменения</button>
    <a href="/Car/ViewAll" class="btn btn-default">Отмена</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}